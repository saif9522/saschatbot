# ===== SAS Chatbot backend on a VPS =====
# Copy to /home/sasbot/app/.env and fill in. Most values: copy them from Render → Environment.
# No spaces around "=". Keep the quotes where shown.

# ---- Server (leave as is)
NODE_ENV=production
PORT=4100
HOST=127.0.0.1
TRUST_PROXY=1
COOKIE_SECURE=true
KEEP_ALIVE=false
FRONTEND_URL=https://saschatbot.com
SESSION_DIR=/home/sasbot/data/wa-sessions
UPLOAD_DIR=/home/sasbot/data/uploads

# ---- MUST be exactly the same as on Render (else WhatsApp numbers must be re-linked and saved keys are lost)
SESSION_SECRET=

# ---- Supabase database (copy both from Render)
DATABASE_URL=""
DIRECT_URL=""

# ---- AI (copy from Render)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Speed
REPLY_DEBOUNCE_SECONDS=1.5
TYPING_MAX_MS=1500
MAX_BOT_REPLIES_PER_HOUR=30
FALLBACK_COOLDOWN_MINUTES=60

# ---- Admin login
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---- Email (copy from Render). On a VPS Gmail SMTP also works (Render free blocked it).
MAIL_FROM_NAME="SAS Chatbot"
MAIL_FROM_EMAIL=
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Razorpay (copy from Render, if set there)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
